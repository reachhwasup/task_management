DATABASE_URL="postgresql://taskuser:taskpass@localhost:5432/taskmanagement?schema=public"
PORT=4000
CLIENT_URL="http://localhost:5173"
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
NODE_ENV="development"

# Google OAuth Client ID (Web application) from https://console.cloud.google.com/apis/credentials
# Must match VITE_GOOGLE_CLIENT_ID in client/.env — see README for setup steps.
GOOGLE_CLIENT_ID=""
